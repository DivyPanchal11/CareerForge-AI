PORT=5000
MONGO_URI=mongodb://localhost:27017/careerforge
JWT_SECRET=your_jwt_secret_key_here
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Google Gemini Free-Tier Configuration
# Approved models: gemini-3.8-flash, gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_API_KEY=your_secret_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_AI_ENABLED=false
GEMINI_MAX_QUESTIONS_PER_REQUEST=10
GEMINI_MAX_REQUESTS_PER_USER_PER_DAY=5
GEMINI_MAX_GLOBAL_REQUESTS_PER_DAY=50
GEMINI_COOLDOWN_SECONDS=15

# Aptitude Daily Application Credit System
APTITUDE_DAILY_CREDIT_ALLOWANCE=100
APTITUDE_CREDIT_COST_PER_QUESTION=2
APTITUDE_BASE_CREDIT_COST=0
APTITUDE_RESERVATION_EXPIRY_SECONDS=180
